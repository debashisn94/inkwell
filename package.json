    "audio": "node tools/finish-audio.mjs",
    "words": "node tools/align-words.mjs",
    "render": "node tools/render.mjs",
    "qa": "node tools/qa.mjs"
  },
  "peerDependencies": {
    "@remotion/bundler": ">=4.0.0",
    "@remotion/renderer": ">=4.0.0"
